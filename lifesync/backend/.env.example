# ─── Email Provider (pick ONE) ───────────────────────────────────────────────
# OPTION A: Resend HTTP API (recommended for cloud deployments like Render)
#   Signup free at https://resend.com → get API key → set below
#   Free tier: 100 emails/day, works reliably from any server
RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM=LifeSync <onboarding@resend.dev>

# OPTION B: SMTP (works locally, may fail from cloud servers with Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=smtp_user_placeholder
SMTP_PASS=smtp_pass_placeholder
FROM_EMAIL=no-reply@lifesync.com

FRONTEND_URL=http://localhost:5173
NODE_ENV=development
USE_MOCK_DB=true
