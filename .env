# ── Gmail SMTP Configuration ────────────────────────────
# To get an App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Generate a new App Password for "Mail" → "Other (FitNovaAI)"
# 5. Paste the 16-character password below

GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Secret key for session tokens (change this to something random)
SECRET_KEY=fitnovaai-secret-key-change-me-2026
